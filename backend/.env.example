# Required for AI-powered text and image analysis
# Get a key from https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key
# OpenAI-compatible international endpoint
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional Alibaba Cloud OSS media storage
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=

# Local development defaults
LOCAL_STORAGE_DIR=storage
DATABASE_URL=sqlite:///./muhafiz.db
AUTHORITY_PHONE=+923001234567
WEATHER_POLL_INTERVAL_SECONDS=600
